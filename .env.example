# Supabase Postgres via the Supavisor TRANSACTION pooler (port 6543).
# Note ?sslmode=require. There is no local Postgres.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# S3 bucket holding raw spans and episode artifacts (the system of record).
S3_BUCKET=continual-trunk-dev

# Standard AWS credential chain — boto3 reads these from the environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Episode assembly rules (TRUNK_SPEC.md §5.2). These WILL be wrong at first —
# that is why they are config, not literals.
EPISODE_IDLE_TIMEOUT_S=1800
EPISODE_MAX_DURATION_S=86400

# Any single captured field larger than this is treated as truncated, and an
# episode containing it cannot be `replayable` (TRUNK_SPEC.md §5.3).
MAX_CAPTURED_FIELD_BYTES=1048576
